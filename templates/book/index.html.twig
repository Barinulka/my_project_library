{% extends 'base.html.twig' %}

{% block importmap %}
    {{ importmap(['app', 'books']) }}
{% endblock %}

{% block title %}
    Список книг
{% endblock %}

{% block content %}
    <div class="books-content" {{ stimulus_controller('books', {
        url: path('api.book_list'),
        createUrl: path('api.books_create'),
        historyUrlTemplate: path('api.books_loans_history', {
            book_id: '__BOOK_ID__'
        })
    }) }}>
        <div class="content-header">
            <h1>Список книг</h1>

            <button type="button" class="button button--primary"
                {{ stimulus_action('books', 'openDialog', 'click') }}>
                Добавить книгу
            </button>
        </div>
        <div class="content-block">
            <template {{ stimulus_target('books', 'cardTemplate') }}>
                <li class="card book-card">
                    <div class="book-card__info">
                        <h2 class="book-card__title" data-field="title"></h2>

                        <div class="book-card__author" data-field="author"></div>

                        <div class="book-card__inventory">
                            Инвентарный номер:
                            <span data-field="inv_number"></span>
                        </div>
                    </div>

                    <div class="book-card__actions">
                        <span class="badge" data-field="availability"></span>

                        <button
                            type="button"
                            class="button button--secondary"
                            data-field="historyButton"
                            {{ stimulus_action('books', 'historyBook', 'click') }}
                        >
                            История
                        </button>
                    </div>
                </li>
            </template>
            <div class="status" {{ stimulus_target('books', 'status') }} role="status"></div>
            <ul class="card-list book-list" {{ stimulus_target('books', 'list') }}></ul>
        </div>

        <dialog class="modal"
            {{ stimulus_target('books', 'dialog') }}
            {{ stimulus_action('books', 'onDialogCancel', 'cancel') }}
                aria-labelledby="create-book-title">
            <h2 id="create-book-title" class="modal__title">Добавить книгу</h2>
            <form class="form"
                {{ stimulus_target('books', 'form') }}
                {{ stimulus_action('books', 'createBook', 'submit') }}>
                <div class="status" role="alert" {{ stimulus_target('books', 'formError') }}></div>
                <div class="form-element">
                    <label for="title">Название книги</label>
                    <input type="text" name="title" id="title" required aria-describedby="book-title-error">
                    <div id="book-title-error" class="form-error" {{ stimulus_target('books', 'titleError') }}></div>
                </div>
                <div class="form-element">
                    <label for="author">Автор книги</label>
                    <input type="text" name="author" id="author" required aria-describedby="book-author-error">
                    <div id="book-author-error" class="form-error" {{ stimulus_target('books', 'authorError') }}></div>
                </div>
                <div class="form-element">
                    <label for="inv_number">Инвентарный номер</label>
                    <input type="text" name="inv_number" id="inv_number" required aria-describedby="book-inv_number-error">
                    <div id="book-inv_number-error" class="form-error" {{ stimulus_target('books', 'invNumberError') }}></div>
                </div>
                <div class="modal__actions">
                    <button type="submit" class="button button--primary"
                        {{ stimulus_target('books', 'submitButton') }}>
                        Добавить
                    </button>
                    <button type="button" class="button button--secondary"
                        {{ stimulus_action('books', 'closeDialog', 'click') }}>
                        Отмена
                    </button>
                </div>
            </form>
        </dialog>

        <dialog class="modal modal--history"
            {{ stimulus_target('books', 'history') }}
            aria-labelledby="history-book-title"
        >
            <h2 id="history-book-title" class="modal__title">История выдач</h2>

            <div class="status" role="status" {{ stimulus_target('books', 'historyStatus') }}></div>

            <ul class="card-list history-list" {{ stimulus_target('books', 'historyList') }}></ul>

            <template {{ stimulus_target('books', 'historyCardTemplate') }}>
                <li class="card history-card">
                    <div class="history-card__reader" data-field="client_name"></div>

                    <div>
                        Выдана:
                        <span data-field="loan_at"></span>
                    </div>

                    <div>
                        Вернуть до:
                        <span data-field="planned_return_at"></span>
                    </div>

                    <div data-field="return_status"></div>
                </li>
            </template>

            <div class="modal__actions">
                <button type="button" class="button button--secondary" {{ stimulus_action('books', 'closeHistory', 'click') }}>
                    Закрыть
                </button>
            </div>
        </dialog>
    </div>
{% endblock %}
